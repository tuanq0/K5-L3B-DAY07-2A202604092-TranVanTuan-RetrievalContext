# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MAX_TOKENS=512
# Must match the model used to create the Day 6 vector index.
EMBEDDING_MODEL=Desktop\embeddinggemma-2
VECTOR_STRATEGY=A
